<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#23644F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F5F0</item>
        <item name="android:navigationBarColor">#F6F5F0</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#459474</item>
        <item name="android:statusBarColor">#14231E</item>
        <item name="android:navigationBarColor">#14231E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
